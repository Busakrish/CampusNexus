# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Leave empty to use automatic embedded in-memory MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/campusnexus

# Security Secrets
JWT_SECRET=super_secure_campusnexus_jwt_secret_key_2026_x99a!
JWT_EXPIRES_IN=7d

# Organization / System Settings
SYSTEM_NAME=CampusNexus
CLIENT_URL=http://localhost:5000

# ==============================================================================
# EMAIL DELIVERY CONFIGURATION (Nodemailer)
# ==============================================================================
# To receive real OTP emails in your inbox, configure either Option A or Option B:
#
# Option A: Gmail (Recommended for quick setup)
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Generate a 16-character App Password (myaccount.google.com/apppasswords)
# 3. Fill in below:
# SMTP_SERVICE=gmail
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="CampusNexus Portal" <your_email@gmail.com>
#
# Option B: Custom SMTP (Outlook, Mailtrap, SendGrid, Hostinger, AWS SES, etc.)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM="CampusNexus Portal" <no-reply@campusnexus.edu>
#
# (Note: If left empty, OTP codes are logged to the backend server terminal)
# ==============================================================================
